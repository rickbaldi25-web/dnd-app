rules_version = '2';

// Modello:
//   users/{uid}           preferenze dell'utente (solo lui)
//   characters/{id}       un personaggio; ownerUid = giocatore, campaignId opzionale
//   campaigns/{id}        dmUid = Master, memberUids = giocatori
//
//   config/access         lista degli ammessi: { emails: ["a@gmail.com", ...] }. Si modifica solo dalla
//                         console Firebase. Se il documento non esiste entra chiunque abbia fatto l'accesso
//                         (è il caso degli emulatori); se esiste, entrano solo le email elencate.
//
// Il giocatore modifica solo i propri personaggi.
// Il Master legge e modifica i personaggi della sua campagna (danni, condizioni...).
// I membri di una campagna vedono i personaggi del gruppo.

service cloud.firestore {
  match /databases/{database}/documents {

    function onList() {
      return !exists(/databases/$(database)/documents/config/access) ||
        request.auth.token.email in get(/databases/$(database)/documents/config/access).data.emails;
    }
    // Tutte le regole passano da qui: senza essere nella lista non si legge né si scrive nulla.
    function signedIn() {
      return request.auth != null && onList();
    }
    function uid() {
      return request.auth.uid;
    }
    function campaignData(id) {
      return get(/databases/$(database)/documents/campaigns/$(id)).data;
    }
    function isDm(id) {
      return id != null && campaignData(id).dmUid == uid();
    }
    function isMember(id) {
      return id != null && (campaignData(id).dmUid == uid() || uid() in campaignData(id).get('memberUids', []));
    }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /characters/{charId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == uid() ||
        isMember(resource.data.get('campaignId', null))
      );
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow update: if signedIn() && (
        (resource.data.ownerUid == uid() && request.resource.data.ownerUid == uid()) ||
        // il Master non può cambiare proprietario né spostare il personaggio
        (isDm(resource.data.get('campaignId', null)) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('campaignId', null) == resource.data.get('campaignId', null))
      );
      allow delete: if signedIn() && resource.data.ownerUid == uid();
    }

    match /campaigns/{campaignId} {
      // L'id della campagna è il codice d'invito: chi lo conosce può leggerla (get),
      // ma non si possono elencare le campagne altrui (list).
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.dmUid == uid() || uid() in resource.data.get('memberUids', []));
      allow create: if signedIn() && request.resource.data.dmUid == uid();
      allow delete: if signedIn() && resource.data.dmUid == uid();
      allow update: if signedIn() && (
        resource.data.dmUid == uid() ||
        // Chi ha il codice può solo aggiungere se stesso tra i giocatori, nient'altro.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
          request.resource.data.memberUids.hasAll(resource.data.get('memberUids', [])) &&
          request.resource.data.memberUids.size() == resource.data.get('memberUids', []).size() + 1 &&
          uid() in request.resource.data.memberUids) ||
        // ...oppure togliersi, per uscire dalla campagna.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
          resource.data.memberUids.hasAll(request.resource.data.memberUids) &&
          request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
          uid() in resource.data.memberUids &&
          !(uid() in request.resource.data.memberUids))
      );

      // Combattimento in corso: lo leggono tutti i membri, lo scrive solo il Master.
      match /state/{docId} {
        allow read: if signedIn() && isMember(campaignId);
        allow write: if signedIn() && isDm(campaignId);
      }
      // PF e CA dei mostri: solo il Master.
      match /secret/{docId} {
        allow read, write: if signedIn() && isDm(campaignId);
      }

      // Fogli del Master: lui li vede e li scrive tutti; un giocatore legge solo quelli che gli sono stati mostrati.
      match /handouts/{handoutId} {
        allow read: if signedIn() && (
          isDm(campaignId) ||
          (isMember(campaignId) && (resource.data.everyone == true || uid() in resource.data.visibleTo))
        );
        allow write: if signedIn() && isDm(campaignId);
      }

      // Note di sessione: il riassunto lo leggono i membri; gli appunti riservati del Master stanno in secret/notes.
      match /sessions/{sessionId} {
        allow read: if signedIn() && isMember(campaignId);
        allow write: if signedIn() && isDm(campaignId);
      }

      // Registro dei tiri: ognuno aggiunge i propri, tutti i membri li leggono, nessuno li modifica.
      match /rolls/{rollId} {
        allow read: if signedIn() && isMember(campaignId);
        allow create: if signedIn() && isMember(campaignId) && request.resource.data.uid == uid();
        allow delete: if signedIn() && isDm(campaignId);
      }
      // Tiri segreti del Master.
      match /secretRolls/{rollId} {
        allow read, write: if signedIn() && isDm(campaignId);
      }

      // Chi è connesso: ognuno scrive solo il proprio segnale, i membri leggono quelli di tutti.
      match /presence/{userId} {
        allow read: if signedIn() && isMember(campaignId);
        allow write: if signedIn() && uid() == userId && isMember(campaignId);
      }
    }
  }
}
