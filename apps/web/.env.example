# --- Sviluppo in locale con gli emulatori Firebase (consigliato) ---
# Con il progetto "demo-dnd" non serve un progetto Firebase reale:
# login Google finto, Firestore locale, nessun costo.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-dnd
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-dnd.firebaseapp.com

# --- Produzione: copia i valori dalla console Firebase (Impostazioni progetto > App web) ---
# VITE_USE_EMULATORS=false
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=tuo-progetto.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=tuo-progetto
# VITE_FIREBASE_APP_ID=...

# Senza alcuna variabile l'app parte in "modalità locale": niente login,
# i personaggi restano nel browser (localStorage).
