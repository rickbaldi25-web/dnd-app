{
  "name": "@dnd/importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Importa compendi XML (formato Fight Club 5e) nel formato di @dnd/engine",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "import": "node scripts/import.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
